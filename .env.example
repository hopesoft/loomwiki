# Copy to .env and supply your key locally. Never commit .env.
LOOMWIKI_PROVIDER=openai
LOOMWIKI_API_KEY=
LOOMWIKI_MODEL=gpt-4.1
LOOMWIKI_MODEL_URL=https://api.openai.com/v1/chat/completions
PORT=4310
# Optional storage paths (keep sources and state together when backing up).
# LOOMWIKI_STATE_DIR=/absolute/path/to/state
# LOOMWIKI_DATA_DIR=/absolute/path/to/sources

# DeepSeek alternative: change all three settings together and use its API key.
# LOOMWIKI_PROVIDER=deepseek
# LOOMWIKI_MODEL=deepseek-flash
# LOOMWIKI_MODEL_URL=https://api.deepseek.com/chat/completions
